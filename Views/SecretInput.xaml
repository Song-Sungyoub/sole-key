<UserControl x:Class="SoleKey.Views.SecretInput" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
  <Border x:Name="Field" CornerRadius="8" Margin="0,4" MinHeight="36">
    <Border.Style><Style TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding ReadOnly, ElementName=Root}" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></DataTrigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </Style.Triggers>
    </Style></Border.Style>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
      <Grid MinWidth="100">
        <PasswordBox x:Name="Masked" PasswordChanged="PasswordChanged" MaxLength="4096" AutomationProperties.Name="숨겨진 비밀번호" Margin="0" BorderThickness="0" Background="Transparent">
          <PasswordBox.Style><Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}"><Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, ElementName=Reveal}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Binding="{Binding ReadOnly, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          </Style.Triggers></Style></PasswordBox.Style>
        </PasswordBox>
        <TextBlock Text="••••••••" Padding="10,0" VerticalAlignment="Center" AutomationProperties.Name="비밀번호 숨김">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ReadOnly, ElementName=Root}" Value="True"/><Condition Binding="{Binding IsChecked, ElementName=Reveal}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
          </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <TextBox x:Name="Plain" Text="{Binding Value, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnly, ElementName=Root}" MaxLength="4096" AutomationProperties.Name="표시된 비밀번호" Margin="0" BorderThickness="0" Background="Transparent">
          <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=Reveal}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
        </TextBox>
      </Grid>
      <ToggleButton x:Name="Reveal" Grid.Column="1" IsChecked="False" Margin="1" Cursor="Hand" VerticalAlignment="Center" Height="30" Width="32">
        <ToggleButton.Style><Style TargetType="ToggleButton">
          <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="ToolTip" Value="비밀번호 보기"/><Setter Property="AutomationProperties.Name" Value="비밀번호 보기"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="EyeBackground" Background="Transparent" CornerRadius="5" BorderBrush="Transparent" BorderThickness="1">
              <Grid Width="18" Height="18"><Path Data="M1,9 C5,2 13,2 17,9 C13,16 5,16 1,9 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" StrokeLineJoin="Round"/><Ellipse Width="5" Height="5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"/><Path x:Name="Slash" Data="M2,2 L16,16" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" Visibility="Collapsed"/></Grid>
            </Border><ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Slash" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EyeBackground" Property="Background" Value="{DynamicResource SoftBlueBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="EyeBackground" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
          <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="ToolTip" Value="비밀번호 숨기기"/><Setter Property="AutomationProperties.Name" Value="비밀번호 숨기기"/></Trigger></Style.Triggers>
        </Style></ToggleButton.Style>
      </ToggleButton>
    </Grid>
  </Border>
</UserControl>
