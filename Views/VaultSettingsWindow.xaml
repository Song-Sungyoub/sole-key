<Window x:Class="SoleKey.Views.VaultSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SoleKey.Views" Style="{StaticResource DialogWindow}" Title="SoleKey · 금고 관리" Width="680" Height="850" MinWidth="560" MinHeight="560" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="22">
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Status}" AutomationProperties.LiveSetting="Polite"/>
    <Border Style="{StaticResource Card}" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding Ready}">
      <TextBlock Text="금고 관리" Style="{StaticResource Heading}"/>
      <TextBlock Text="{Binding FilePath}" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
      <TextBlock Text="자동 잠금 (1~60분)"/><TextBox Text="{Binding AutoLockMinutes, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="자동 잠금 분"/>
      <TextBlock Text="클립보드 정리 (5~120초)"/><TextBox Text="{Binding ClipboardSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="클립보드 정리 초"/>
      <Button Content="시간 설정 저장" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Right"/>
      <Separator Margin="0,14"/>
      <Button Content="암호화 백업 만들기" Command="{Binding BackupCommand}" HorizontalAlignment="Left"/>
      <TextBlock Text="복원할 백업의 마스터 비밀번호" Margin="0,12,0,0"/>
      <local:SecretInput Value="{Binding RestorePassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Content="백업 선택 후 복원" Command="{Binding RestoreCommand}" HorizontalAlignment="Right"/>
      <TextBlock Text="복원 전 현재 금고를 자동 백업하며, 복원 후 다시 잠금을 해제해야 합니다." Style="{StaticResource MutedText}"/>
      <Separator Margin="0,14"/>
      <TextBlock Text="마스터 비밀번호 변경" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
      <TextBlock Text="현재 비밀번호"/><local:SecretInput Value="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="새 비밀번호 (15~128자)"/><local:SecretInput Value="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="새 비밀번호 확인"/><local:SecretInput Value="{Binding Confirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Content="마스터 비밀번호 변경" Command="{Binding ChangePasswordCommand}" HorizontalAlignment="Right"/>
      <TextBlock Text="이전 백업은 변경 전 비밀번호로 열립니다. 비밀번호를 잊으면 복구할 수 없습니다." Style="{StaticResource MutedText}" Margin="0,8"/>
    </StackPanel></ScrollViewer></Border>
  </DockPanel>
</Window>
